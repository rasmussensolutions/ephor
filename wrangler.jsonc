{
  "$schema": "./apps/worker/node_modules/wrangler/config-schema.json",
  "name": "ephor",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "EPHOR_ORIGIN": "https://ephor.YOUR-SUBDOMAIN.workers.dev",
    "EPHOR_RELEASE_URL": "https://github.com/rasmussensolutions/ephor/releases/latest/download/release.json",
    "EPHOR_RELEASE_PUBLIC_KEY": "69fcf97385688a836880535bad05d49fcf2b4a09bd54315546c458efe3d53b2b"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ephor",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "packages/api/migrations/sqlite"
    }
  ],
  "assets": {
    "directory": "apps/dashboard/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health",
      "/mcp",
      "/oauth/*",
      "/.well-known/*"
    ]
  },
  "workers_dev": true,
  "preview_urls": false
}
