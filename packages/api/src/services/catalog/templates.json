          "port": 5432,
          "memoryMb": 512,
          "cpus": 1,
          "user": "999:999",
          "environment": {
            "POSTGRES_USER": "ephor",
            "POSTGRES_DB": "app",
            "POSTGRES_PASSWORD": "${DB_PASSWORD}",
            "PGDATA": "/var/lib/postgresql/18/docker"
          },
          "volumes": [
            {
              "key": "database",
              "target": "/var/lib/postgresql",
              "uid": 999
            }
          ],
          "health": ["CMD", "pg_isready", "-U", "ephor", "-d", "app"],
          "command": [],
          "capabilities": [],
          "tmpfs": {
            "/var/run/postgresql": "rw,nosuid,size=16m,mode=1777"
          },
          "internal": false
        }
      ],
      "secrets": ["DB_PASSWORD"],
      "notes": "PostgreSQL 18. Enable supported extensions in service settings. Existing PostgreSQL 17 services retain their version; use a logical restore into a new database to upgrade."
    }
  ]
}
